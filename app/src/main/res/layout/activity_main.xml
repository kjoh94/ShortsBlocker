<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚫"
            android:textSize="64sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="쇼츠 차단기"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/allowlist_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/allowlist_heading_default"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/allowlist_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#333333"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/pause_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="일시정지 (60초)"
            android:textSize="16sp"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/allowlist_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/allowlist_edit"
            android:textSize="15sp"
            android:padding="12dp"
            android:backgroundTint="#546E7A"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="최초 1회: 설정 &gt; 접근성 &gt; 다운로드된 앱 &gt; 쇼츠 차단기 활성화"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"/>

    </LinearLayout>
</ScrollView>
